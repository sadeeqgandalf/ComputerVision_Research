# Envs
.venv/
.venv_sam3/
venv/
__pycache__/
*.py[cod]
.Python
*.egg-info/
.eggs/

# OS / IDE
.DS_Store
.idea/
.vscode/
*.swp

# Large / local-only data (download on GPU host)
Research_Data/
data/
# Keep SAM3 train package (root data/ would otherwise ignore it)
!sam3/sam3/train/data/
!sam3/sam3/train/data/**
datasets/
# Vendored TrackEval needs its datasets package (imported by trackeval/__init__.py)
!TrackEval/trackeval/datasets/

# Heavy run artifacts
outputs/**/*.pkl
outputs/**/frames_*/
outputs/SAM3.1/tracking/raw/**/frames_*/
*.pt
*.pth
*.ckpt
*.safetensors
*.bin

# Keep small demo outputs optional — ignore large videos by default
outputs/**/*.mp4
!outputs/**/*_preview.jpg
!outputs/SAM3/tracking/metrics/**
!outputs/SAM3.1/tracking/metrics/**
!outputs/SAM3/research/**

# Caches
.cache/
**/hf_cache/
**/.huggingface/
**/__pycache__/

# Local reference PDFs (copyrighted; do not commit)
Computer vision research/refs/*.pdf

# Secrets
.env
.env.*
!.env.example
*.pem

# Local only: third-party clone, editor and OS files
cosmos~/
.cursor/
.DS_Store
